{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    "eslint.config.mjs",
    "vitest.config.ts",
    ".dependency-cruiser.mjs",
    "scripts/check-boundaries.mjs"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "agentGuidance": false
}
